<Window x:Class="Lab1.Work2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Стрічка вводу" Height="250" Width="350"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Введіть текст нижче:" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <TextBox x:Name="InputTextBox" Height="30" Margin="0,0,0,20"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Так" Width="80" Height="30" Margin="5" Click="YesButton_Click"/>
                <Button Content="Відміна" Width="80" Height="30" Margin="5" Click="CancelButton_Click"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
