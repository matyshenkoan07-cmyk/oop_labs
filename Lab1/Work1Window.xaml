<Window x:Class="Lab1.Work1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вибір числа (Повзунок)" Height="250" Width="350"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Оберіть число за допомогою повзунка:" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <TextBlock x:Name="ValueLabel" Text="50" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Slider x:Name="MySlider" Minimum="1" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" 
                    ValueChanged="MySlider_ValueChanged" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Так" Width="80" Height="30" Margin="5" Click="YesButton_Click"/>
                <Button Content="Відміна" Width="80" Height="30" Margin="5" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>