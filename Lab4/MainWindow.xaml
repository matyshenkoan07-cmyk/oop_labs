<Window x:Class="Lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №4 - Матюшенко Анастасія" Height="500" Width="850">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Вихід" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Об’єкти" x:Name="objectsMenu" SubmenuOpened="ObjectsMenu_SubmenuOpened">
                <MenuItem x:Name="pointMenuItem" Header="Крапка" Click="Point_Click"/>
                <MenuItem x:Name="lineMenuItem" Header="Лінія" Click="Line_Click"/>
                <MenuItem x:Name="rectMenuItem" Header="Прямокутник" Click="Rectangle_Click"/>
                <MenuItem x:Name="ellipseMenuItem" Header="Еліпс" Click="Ellipse_Click"/>
                <MenuItem x:Name="lineCirclesMenuItem" Header="Лінія з кружечками" Click="LineWithCircles_Click"/>
                <MenuItem x:Name="cubeMenuItem" Header="Каркас куба" Click="Cube_Click"/>
            </MenuItem>
            <MenuItem Header="Довідка">
                <MenuItem Header="Про програму" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <ToggleButton x:Name="pointButton" Width="32" Height="32" ToolTip="Крапка" Click="Point_Click">
                <Canvas Width="20" Height="20">
                    <Ellipse Width="6" Height="6" Fill="Black" Canvas.Left="7" Canvas.Top="7"/>
                </Canvas>
            </ToggleButton>

            <ToggleButton x:Name="lineButton" Width="32" Height="32" ToolTip="Лінія" Click="Line_Click">
                <Canvas Width="20" Height="20">
                    <Line X1="3" Y1="17" X2="17" Y2="3" Stroke="Black" StrokeThickness="2"/>
                </Canvas>
            </ToggleButton>

            <ToggleButton x:Name="rectButton" Width="32" Height="32" ToolTip="Прямокутник" Click="Rectangle_Click">
                <Canvas Width="20" Height="20">
                    <Rectangle Width="16" Height="12" Canvas.Left="2" Canvas.Top="4"
                               Stroke="Black" StrokeThickness="2" Fill="Yellow"/>
                </Canvas>
            </ToggleButton>

            <ToggleButton x:Name="ellipseButton" Width="32" Height="32" ToolTip="Еліпс" Click="Ellipse_Click">
                <Canvas Width="20" Height="20">
                    <Ellipse Width="16" Height="12" Canvas.Left="2" Canvas.Top="4"
                             Stroke="Black" StrokeThickness="2"/>
                </Canvas>
            </ToggleButton>

            <Separator/>

            <ToggleButton x:Name="lineCirclesButton" Width="32" Height="32" ToolTip="Лінія з кружечками" Click="LineWithCircles_Click">
                <Canvas Width="20" Height="20">
                    <Line X1="4" Y1="16" X2="16" Y2="4" Stroke="Black" StrokeThickness="2"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="2" Canvas.Top="14" Fill="Red"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="14" Canvas.Top="2" Fill="Red"/>
                </Canvas>
            </ToggleButton>

            <ToggleButton x:Name="cubeButton" Width="32" Height="32" ToolTip="Каркас куба" Click="Cube_Click">
                <Canvas Width="20" Height="20">
                    <Rectangle Width="10" Height="10" Canvas.Left="2" Canvas.Top="8" Stroke="Black" StrokeThickness="1"/>
                    <Rectangle Width="10" Height="10" Canvas.Left="7" Canvas.Top="3" Stroke="Black" StrokeThickness="1"/>
                    <Line X1="2" Y1="8" X2="7" Y2="3" Stroke="Black" StrokeThickness="1"/>
                    <Line X1="12" Y1="8" X2="17" Y2="3" Stroke="Black" StrokeThickness="1"/>
                    <Line X1="2" Y1="18" X2="7" Y2="13" Stroke="Black" StrokeThickness="1"/>
                    <Line X1="12" Y1="18" X2="17" Y2="13" Stroke="Black" StrokeThickness="1"/>
                </Canvas>
            </ToggleButton>
        </ToolBar>

        <Canvas x:Name="drawingCanvas" Background="White" ClipToBounds="True"
                MouseLeftButtonDown="drawingCanvas_MouseLeftButtonDown"
                MouseMove="drawingCanvas_MouseMove"
                MouseLeftButtonUp="drawingCanvas_MouseLeftButtonUp"/>
    </DockPanel>
</Window>