<Window x:Class="Lab6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab6 - Головний менеджер (Матюшенко А.Ю.)" Height="300" Width="400"
        Closed="MainWindow_Closed" WindowStartupLocation="Manual">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Завдання">
                <MenuItem Header="Ввести параметри та виконати" Click="ExecuteTask_Click"/>
                <Separator/>
                <MenuItem Header="Вихід" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Керування додатками Object2 та Object3" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            <Button Content="Запустити обробку (Варіант 3)" Click="ExecuteTask_Click" Height="40" FontSize="12" Padding="10,5"/>
        </StackPanel>
    </DockPanel>
</Window>