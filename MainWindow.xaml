<Window x:Class="Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №3 - Матюшенко Анастасія" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Вихід" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Об’єкти" x:Name="objectsMenu" SubmenuOpened="ObjectsMenu_SubmenuOpened">
                <MenuItem x:Name="pointMenuItem" Header="Крапка" Click="Point_Click"/>
                <MenuItem x:Name="lineMenuItem" Header="Лінія" Click="Line_Click"/>
                <MenuItem x:Name="rectMenuItem" Header="Прямокутник" Click="Rectangle_Click"/>
                <MenuItem x:Name="ellipseMenuItem" Header="Еліпс" Click="Ellipse_Click"/>
            </MenuItem>
            <MenuItem Header="Довідка">
                <MenuItem Header="Про програму" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <ToolBar DockPanel.Dock="Top">
            <ToggleButton x:Name="pointButton" Width="32" Height="32" ToolTip="Крапка" Click="Point_Click">
                <Canvas Width="20" Height="20">
                    <Ellipse Width="6" Height="6" Fill="Black" Canvas.Left="7" Canvas.Top="7"/>
                </Canvas>
            </ToggleButton>
            <ToggleButton x:Name="lineButton" Width="32" Height="32" ToolTip="Лінія" Click="Line_Click">
                <Canvas Width="20" Height="20">
                    <Line X1="3" Y1="17" X2="17" Y2="3" Stroke="Black" StrokeThickness="2"/>
                </Canvas>
            </ToggleButton>
            <ToggleButton x:Name="rectButton" Width="32" Height="32" ToolTip="Прямокутник" Click="Rectangle_Click">
                <Canvas Width="20" Height="20">
                    <Rectangle Width="16" Height="12" Canvas.Left="2" Canvas.Top="4"
                               Stroke="Black" StrokeThickness="2" Fill="Yellow"/>
                </Canvas>
            </ToggleButton>
            <ToggleButton x:Name="ellipseButton" Width="32" Height="32" ToolTip="Еліпс" Click="Ellipse_Click">
                <Canvas Width="20" Height="20">
                    <Ellipse Width="16" Height="12" Canvas.Left="2" Canvas.Top="4"
                             Stroke="Black" StrokeThickness="2"/>
                </Canvas>
            </ToggleButton>
        </ToolBar>

        <Canvas x:Name="drawingCanvas" Background="White" ClipToBounds="True"
                MouseLeftButtonDown="drawingCanvas_MouseLeftButtonDown"
                MouseMove="drawingCanvas_MouseMove"
                MouseLeftButtonUp="drawingCanvas_MouseLeftButtonUp"/>
    </DockPanel>
</Window>