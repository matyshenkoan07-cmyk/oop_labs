<Window x:Class="Lab5.MyTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Таблиця графічних об’єктів" Height="350" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="objectsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="ObjectsDataGrid_SelectionChanged" Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="x1" Binding="{Binding X1, StringFormat={}{0:F0}}" Width="60"/>
                <DataGridTextColumn Header="y1" Binding="{Binding Y1, StringFormat={}{0:F0}}" Width="60"/>
                <DataGridTextColumn Header="x2" Binding="{Binding X2, StringFormat={}{0:F0}}" Width="60"/>
                <DataGridTextColumn Header="y2" Binding="{Binding Y2, StringFormat={}{0:F0}}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="0,10,0,0">
            <Button Content="Видалити обраний об'єкт" Click="DeleteButton_Click" Padding="10,5" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>